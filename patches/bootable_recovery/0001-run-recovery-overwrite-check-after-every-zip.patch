index 13411bb..78756d6 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -4980,6 +4980,60 @@ std::pair<string, string> TWPartitionManager::Get_Partition_Checksums(TWPartitio
 	return res;
 }
 
+static string Get_Block_Device_Sectors_Written(const string& block_device) {
+	if (block_device.empty())
+		return "";
+
+	char* resolved = realpath(block_device.c_str(), NULL);
+	if (!resolved)
+		return "";
+
+	string device_name(resolved);
+	free(resolved);
+
+	size_t slash = device_name.find_last_of('/');
+	if (slash != string::npos)
+		device_name = device_name.substr(slash + 1);
+	if (device_name.empty())
+		return "";
+
+	string stat_path = "/sys/class/block/" + device_name + "/stat";
+	string contents;
+	if (!android::base::ReadFileToString(stat_path, &contents))
+		return "";
+
+	// field 7 (1-based) of the blockdev stat line is the number of sectors written
+	std::vector<string> fields = android::base::Split(android::base::Trim(contents), " \t");
+	int seen = 0;
+	for (size_t i = 0; i < fields.size(); i++) {
+		if (fields.at(i).empty())
+			continue;
+		if (++seen == 7)
+			return fields.at(i);
+	}
+
+	return "";
+}
+
+std::pair<string, string> TWPartitionManager::Get_Partition_Write_Counters(TWPartition* twrpPart) {
+	std::pair<string, string> res;
+	if (!twrpPart)
+		return res;
+
+	if (twrpPart->Is_SlotSelect()) {
+		res.first = Get_Block_Device_Sectors_Written(twrpPart->Primary_Block_Device + "_a");
+		res.second = Get_Block_Device_Sectors_Written(twrpPart->Primary_Block_Device + "_b");
+		if (res.first.empty() || res.second.empty()) {
+			res.first.clear();
+			res.second.clear();
+		}
+	} else {
+		res.first = Get_Block_Device_Sectors_Written(twrpPart->Primary_Block_Device);
+	}
+
+	return res;
+}
