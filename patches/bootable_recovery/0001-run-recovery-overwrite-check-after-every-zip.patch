-      // success - but what have we just installed?
-      if (Fox_Zip_Installer_Code != 0) // we have just installed a ROM - ideally, the user should reboot the recovery
-       {
-          Fox_Post_Zip_Install(INSTALL_SUCCESS);
-       }
+      // Success. Always call this: it decides internally what applies.
+      // ROM-specific work stays gated on Fox_Zip_Installer_Code != 0, but the
+      // recovery-overwrite check must run for any zip, including non-ROM
+      // installers that overwrite the recovery partition(s).
+      Fox_Post_Zip_Install(INSTALL_SUCCESS);
 
        usleep(250000);
      } // for i
