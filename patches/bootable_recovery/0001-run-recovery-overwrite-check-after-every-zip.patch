diff --git a/twrp-functions.cpp b/twrp-functions.cpp
index 24b7ec0..8755f4a 100755
--- a/twrp-functions.cpp
+++ b/twrp-functions.cpp
@@ -5133,6 +5133,7 @@ void TWFunc::FoxThemeCheck()
 
 bool TWFunc::IsRecoveryOverwritten(bool only_update) {
 	static std::pair<string, string> previous_checksums;
+	static std::pair<string, string> previous_counters;
 	TWPartition* target_partition = PartitionManager.Find_Partition_By_Path("/boot");
 #if defined(FOX_VENDOR_BOOT_RECOVERY) || defined(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT)
 	target_partition = PartitionManager.Find_Partition_By_Path("/vendor_boot");
@@ -5143,6 +5144,18 @@ bool TWFunc::IsRecoveryOverwritten(bool only_update) {
 	if (!target_partition)
 		return false;
 
+	// Cheap pre-filter: if the kernel says nothing has been written to the partition
+	// since the last time we hashed it, the stored checksums are still valid and the
+	// (expensive) hashing can be skipped. Only ever used to skip work, never to
+	// declare the recovery overwritten -- a counter that moved still gets hashed.
+	std::pair<string, string> current_counters = PartitionManager.Get_Partition_Write_Counters(target_partition);
+	bool counters_usable = !current_counters.first.empty() && !previous_counters.first.empty();
+	if (counters_usable && previous_counters == current_counters && !previous_checksums.first.empty()) {
+		if (!only_update)
+			LOGINFO("%s: No writes to %s since the last check\n", __func__, target_partition->Get_Mount_Point().c_str());
+		return false;
+	}
+
 	std::pair<string, string> current_checksums = PartitionManager.Get_Partition_Checksums(target_partition);
 	if (current_checksums.first.empty()) {
 		LOGINFO("%s: Cannot get checksums\n", __func__);
@@ -5151,11 +5164,13 @@ bool TWFunc::IsRecoveryOverwritten(bool only_update) {
 
 	if (only_update) {
 		previous_checksums = current_checksums;
+		previous_counters = current_counters;
 		return false;
 	}
 
 	if (previous_checksums.first.empty() || previous_checksums == current_checksums) {
 		previous_checksums = current_checksums;
+		previous_counters = current_counters;
 		LOGINFO("%s: The checksums match for %s\n", __func__, target_partition->Get_Mount_Point().c_str());
 		return false;
 	}
