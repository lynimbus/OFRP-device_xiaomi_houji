+// Restore OrangeFox if the just-installed zip overwrote the recovery partition(s).
+// Runs for every successfully installed zip, not just ROMs: a non-ROM installer can
+// overwrite recovery just as easily. Self-gating -- the baseline is taken before every
+// zip, and IsRecoveryOverwritten() returns false unless the slots really changed.
+static void Fox_Restore_Overwritten_Recovery()
+{
+#ifdef AB_OTA_UPDATER
+   if (!DataManager::GetIntValue(TW_AUTO_REFLASHTWRP_VAR))
+	return;
+
+   if (TWFunc::IsRecoveryOverwritten()) {
+	gui_msg("fox_recovery_overwritten=- The recovery partition was overwritten; restoring OrangeFox...");
+	twrpRepacker repacker;
+	repacker.Flash_Current_Twrp(); // calls Update_System_Details() itself
+	TWFunc::IsRecoveryOverwritten(true);
+   }
+#endif
+}
+
 void Fox_Post_Zip_Install(const int result)
 {
    if (result != INSTALL_SUCCESS)
@@ -1112,13 +1132,7 @@ void Fox_Post_Zip_Install(const int result)
 	}
 	#endif
 	//---- Virtual A/B compensations ---- //
-#ifdef AB_OTA_UPDATER
-	if (DataManager::GetIntValue(TW_AUTO_REFLASHTWRP_VAR) && TWFunc::IsRecoveryOverwritten()) {
-		twrpRepacker repacker;
-		repacker.Flash_Current_Twrp();
-		TWFunc::IsRecoveryOverwritten(true);
-	}
-#endif
+	Fox_Restore_Overwritten_Recovery();
          PartitionManager.Update_System_Details();
 	// Run any custom script after completion of all ROM flashing processes
 	TWFunc::RunFoxScript("/system/bin/post_rom_flash_completion.sh", "");
@@ -1128,6 +1142,10 @@ void Fox_Post_Zip_Install(const int result)
 	gui_print_color("warning", "\n\nYou must now reboot OrangeFox - immediately!\n\nDo NOT attempt anything else, without first rebooting OrangeFox.\n");
 #endif
      }
+   else
+     {
+	Fox_Restore_Overwritten_Recovery();
+     }
 }
 
